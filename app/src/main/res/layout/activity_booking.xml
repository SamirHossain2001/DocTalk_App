<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="70dp"

    android:paddingHorizontal="20dp"
    android:background="@color/white"
    >

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Book Appointment"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:layout_marginBottom="20dp"
        android:textColor="@color/blue_primary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F5F5F5"
        android:padding="16dp"
        android:layout_marginBottom="20dp">

        <TextView
            android:id="@+id/doctorNameText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Md. Samir Hossain"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"
            android:textColor="#333333" />

        <TextView
            android:id="@+id/specializationText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Specialization: Cardiology"
            android:textSize="16sp"
            android:layout_marginBottom="4dp"
            android:textColor="#666666" />

        <TextView
            android:id="@+id/hospitalText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hospital: Mugda Hospital"
            android:textSize="16sp"
            android:layout_marginBottom="4dp"
            android:textColor="#666666" />

        <TextView
            android:id="@+id/feeText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fee: 1000 TK"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#4CAF50" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Patient Information"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"
        android:textColor="#333333" />

    <EditText
        android:id="@+id/patientNameEdit"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:hint="Patient Name"
        android:inputType="textPersonName"
        android:background="#FFFFFF"
        android:padding="8dp"
        android:layout_marginBottom="8dp" />

    <EditText
        android:id="@+id/patientPhoneEdit"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:hint="Phone Number"
        android:inputType="phone"
        android:background="#FFFFFF"
        android:padding="8dp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Appointment Details"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"
        android:textColor="#333333" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <EditText
            android:id="@+id/selectedDateEdit"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:hint="Select Date"
            android:focusable="false"
            android:clickable="true"
            android:background="#FFFFFF"
            android:padding="8dp"
            android:layout_toStartOf="@id/selectDateButton" />

        <Button
            android:id="@+id/selectDateButton"
            android:layout_width="wrap_content"
            android:layout_height="45dp"
            android:layout_alignParentEnd="true"
            android:text="Select"
            android:backgroundTint="@color/blue_primary"
            />

    </RelativeLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select Time"
        android:textSize="16sp"
        android:layout_marginBottom="8dp"
        android:textColor="#000000" />

    <Spinner
        android:id="@+id/timeSpinner"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:background="#FFFFFF"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/bookAppointmentButton"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:text="Book Appointment"
        android:textSize="16sp"
        android:textStyle="bold"
        android:backgroundTint="@color/blue_primary"
        android:textColor="#FFFFFF" />

</LinearLayout>